# === OBRIGATORIO ===
# Pegue em: https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=seu_token_aqui

# IA gratuita Google Gemini - pegue em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.0-flash

# === OPCIONAL ===
COMMAND_PREFIX=!
LOG_LEVEL=INFO

# Moderacao: IDs de cargos de mod separados por virgula (opcional)
# Ex: MOD_ROLE_IDS=123456789,987654321
MOD_ROLE_IDS=

# Canal de log de moderacao (ID do canal, opcional)
MODLOG_CHANNEL_ID=0

# Filtro basico: palavras/bloqueios separados por virgula
BANNED_WORDS=spam,http://,https://

# === BANCO POSTGRES (Docker - VPS) ===
# No docker-compose o bot usa o servico 'db' interno.
# Local sem Docker: use localhost. Ex:
# DATABASE_URL=postgresql+asyncpg://bot:bot_secret@localhost:5432/botdb
DATABASE_URL=postgresql+asyncpg://bot:bot_secret_troque_aqui@localhost:5432/botdb
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot_secret_troque_aqui
POSTGRES_DB=botdb

# === LEVELS ===
XP_PER_MESSAGE_MIN=5
XP_PER_MESSAGE_MAX=15
XP_COOLDOWN_SECONDS=60

# === WARNS ===
WARN_MAX=3
WARN_AUTOMUTE_MINUTES=60

# === BOAS-VINDAS ===
WELCOME_CHANNEL_ID=0
WELCOME_MESSAGE=Bem-vindo(a) {member} ao {guild}! Digite !help para comecar.
AUTOROLE_IDS=

# === AUTOMOD ===
AUTOMOD_MAX_MSG=5
AUTOMOD_WINDOW_SECONDS=10
AUTOMOD_MUTE_MINUTES=10
AUTOMOD_WHITELIST_CHANNELS=
AUTOMOD_DELETE_INVITES=1

# === TICKETS ===
TICKET_CATEGORY_ID=0
TICKET_STAFF_ROLE_IDS=
TICKET_LOG_CHANNEL_ID=0
TICKET_MAX_OPEN_PER_USER=3

# === DASHBOARD WEB (FastAPI - opcional) ===
# Ativa o painel interno (apenas localhost)
DASHBOARD_ENABLED=0
DASHBOARD_PORT=8000
AI_CACHE_ENABLED=1
AI_CACHE_TTL_HOURS=24

# === DASHBOARD (opcional, só localhost) ===
DASHBOARD_ENABLED=0
DASHBOARD_PORT=8000
